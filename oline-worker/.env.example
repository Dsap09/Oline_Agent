# ============================================================
# Oline Worker — Environment (di-set di dashboard Render)
# Salin file ini jadi .env lokal untuk uji, dan isi nilainya di
# Render (Environment > Environment Variables).
# Nilai token yang TANDA #SAMA diisi sama dengan nilai di .env Vercel/lokal.
# ============================================================

# Shared secret antara Vercel & Render (WAJIB SAMA di kedua sisi).
# Gunakan nilai yang di-generate: kuQRdAUCDOhbVz6-0yWN4xk1aBiNbxNIqnWSgaPacVw
OLINE_WORKER_KEY=kuQRdAUCDOhbVz6-0yWN4xk1aBiNbxNIqnWSgaPacVw

# Token Telegram bot (SAMA dengan TELEGRAM_BOT_TOKEN di Vercel)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# DeepInfra untuk generasi landing page (SAMA dengan DEEPINFRA_API_KEY di Vercel)
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# (Opsional) Token fallback model AI — SAMA dengan di Vercel
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Token Vercel untuk deploy dari worker (SAMA dengan VERCEL_API_TOKEN di Vercel)
VERCEL_API_TOKEN=your_vercel_api_token_here

# Vercel KV (Redis REST) — SAMA dengan KV_REST_API_URL / KV_REST_API_TOKEN di Vercel.
# Dipakai worker untuk bersihkan pending task & baca progress message.
KV_REST_API_URL=your_vercel_kv_rest_api_url_here
KV_REST_API_TOKEN=your_vercel_kv_rest_api_token_here

# URL callback Vercel untuk notifikasi hasil worker (ganti <proyek> dengan subdomain
# project Vercel, misal oline-personal.vercel.app)
VERCEL_CALLBACK_URL=https://<proyek>.vercel.app/api/callback

# Neo4j AuraDB (Activity Graph) — SAMA dengan di Vercel.
# Worker mencatat aktivitas ke graph Neo4j, wajib diset di sini.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
