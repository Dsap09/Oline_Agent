{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/keepalive.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/process_pending.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/token_check.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/delegate.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/callback.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "^/api/keepalive/?$",
      "dest": "/api/keepalive.py"
    },
    {
      "src": "^/api/process_pending/?$",
      "dest": "/api/process_pending.py"
    },
    {
      "src": "^/api/token_check/?$",
      "dest": "/api/token_check.py"
    },
    {
      "src": "^/api/delegate/?$",
      "dest": "/api/delegate.py"
    },
    {
      "src": "^/api/callback/?$",
      "dest": "/api/callback.py"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.py"
    }
  ]
}
